    "By default, localized titles for the app won't be changed, however this option overrides it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بشكل افتراضي، لن يتم تغيير العناوين المترجمة للتطبيق، لكن هذا الخيار يتجاوز ذلك."
          }
